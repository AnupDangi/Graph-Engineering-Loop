#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENDORED_CLI="$SCRIPT_DIR/../vendor/cli/cli.js"
LOCAL_CLI="$SCRIPT_DIR/../../packages/cli/dist/cli.js"

if [[ -f "$VENDORED_CLI" ]]; then
  exec node "$VENDORED_CLI" "$@"
fi

if [[ -f "$LOCAL_CLI" ]]; then
  exec node "$LOCAL_CLI" "$@"
fi

echo "LoopGraph plugin runtime is missing. Run 'npm run build:plugin' in the source repository." >&2
exit 127
