{
  "name": "graph-engineering-loop-core",
  "version": "0.3.0",
  "description": "Harness-neutral core runtime for dependency-aware completion-driven engineering loop graphs.",
  "type": "module",
  "license": "MIT",
  "author": "Anup Dangi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnupDangi/Graph-Engineering-Loop.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  }
